# Track only the minimal Unity project structure.
/*
!/.gitignore
!/HDCD.md
!/.vscode/
!/Assets/
!/Packages/
!/ProjectSettings/
!/chats/
!/gateway/
!/gateway/fxplc_gateway/
!/gateway/fxplc_gateway/**
!/third_party/
!/third_party/fxplc/
!/third_party/fxplc/**

# Unity generated files and local machine state.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/.vs/
/.utmp/

# Local tools, exports, and build artifacts.
/.claude/
/Tools/
/_pdf_extract_demo/
/build-*/
/webgl-scorm/
*.zip
*.log
__pycache__/
*.pyc

# Unity/editor generated files that should not be committed.
/Assets/_Recovery.meta
/Assets/_Recovery/
/Assets/Plugins/Editor/JetBrains*
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
sysinfo.txt
mono_crash.*

# Unity build/package outputs.
*.apk
*.aab
*.unitypackage
*.app
