--- !u!114 &1056956501
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1056956499}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "H\u1EC7 th\u1ED1ng ho\u1EA1t \u0111\u1ED9ng theo c\u1EA5u tr\xFAc \u0111i\u1EC1u
    khi\u1EC3n v\xF2ng k\xEDn: HMI nh\u1EADp l\u1EC7nh, PLC x\u1EED l\xFD v\xE0 ph\xE1t
    xung t\u1ED1c \u0111\u1ED9 cao \u0111\u1EBFn Servo Driver. Driver khu\u1EBFch
    \u0111\u1EA1i, \u0111i\u1EC1u ch\u1EBF PWM v\xE0 c\u1EA5p \u0111i\u1EC7n ba pha
    cho \u0111\u1ED9ng c\u01A1. Encoder ph\u1EA3n h\u1ED3i xung v\u1EC1 PLC \u0111\u1EC3
    x\xE1c \u0111\u1ECBnh chi\u1EC1u quay, t\u1ED1c \u0111\u1ED9 v\xE0 v\u1ECB tr\xED
    th\u1EF1c t\u1EBF.\n\n\u2022 T\u1ED1c \u0111\u1ED9 ph\u1EE5 thu\u1ED9c v\xE0o
    t\u1EA7n s\u1ED1 xung ph\xE1t t\u1EEB PLC.\n\u2022 V\u1ECB tr\xED/g\xF3c quay
    ph\u1EE5 thu\u1ED9c v\xE0o t\u1ED5ng s\u1ED1 xung \u0111i\u1EC1u khi\u1EC3n.\n\u2022
    Encoder pha A/B l\u1EC7ch 90\xB0 gi\xFAp x\xE1c \u0111\u1ECBnh chi\u1EC1u quay
    v\xE0 s\u1ED1 xung th\u1EF1c t\u1EBF.\n\u2022 Bi\xEAn d\u1EA1ng t\u0103ng t\u1ED1c
    \u2013 ch\u1EA1y \u0111\u1EC1u \u2013 gi\u1EA3m t\u1ED1c gi\xFAp \u0111\u1ED9ng
    c\u01A1 v\u1EADn h\xE0nh \xEAm, h\u1EA1n ch\u1EBF qu\xE1 t\u1EA3i."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
