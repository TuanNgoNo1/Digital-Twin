  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 PLC Mitsubishi FX3U: trung t\xE2m \u0111i\u1EC1u khi\u1EC3n, nh\u1EADn
    d\u1EEF li\u1EC7u t\u1EEB HMI, t\xEDnh to\xE1n t\u1EA7n s\u1ED1/s\u1ED1 xung,
    ph\xE1t xung qua Y0 v\xE0 \u0111i\u1EC1u khi\u1EC3n h\u01B0\u1EDBng qua Y1.\n\u2022
    HMI GOT1000: nh\u1EADp t\u1ED1c \u0111\u1ED9, v\u1ECB tr\xED/g\xF3c quay, ch\u1ECDn
    chi\u1EC1u quay, START/STOP/RESET v\xE0 hi\u1EC3n th\u1ECB tr\u1EA1ng th\xE1i
    theo th\u1EDDi gian th\u1EF1c.\n\u2022 Servo Driver + BLDC Servo: bi\u1EBFn t\xEDn
    hi\u1EC7u xung/h\u01B0\u1EDBng th\xE0nh ngu\u1ED3n ba pha \u0111\u1EC3 \u0111i\u1EC1u
    khi\u1EC3n t\u1ED1c \u0111\u1ED9 v\xE0 v\u1ECB tr\xED ch\xEDnh x\xE1c.\n\u2022
    Encoder: ph\u1EA3n h\u1ED3i pha A/B v\u1EC1 PLC \u0111\u1EC3 x\xE1c \u0111\u1ECBnh
    chi\u1EC1u quay, t\u1ED1c \u0111\u1ED9 v\xE0 v\u1ECB tr\xED th\u1EF1c t\u1EBF.\n\u2022
    B\u1ED9 ngu\u1ED3n, b\u1EA3o v\u1EC7, d\xE2y/jack v\xE0 \u0111\u1ED3ng h\u1ED3
    \u0111o: b\u1EA3o \u0111\u1EA3m c\u1EA5p ngu\u1ED3n \u0111\xFAng m\u1EE9c, \u0111\u1EA5u
    n\u1ED1i an to\xE0n v\xE0 ki\u1EC3m tra tr\u01B0\u1EDBc khi v\u1EADn h\xE0nh."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
