  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "B\xE0i th\u1EF1c h\xE0nh gi\xFAp sinh vi\xEAn l\xE0m quen v\u1EDBi h\u1EC7
    truy\u1EC1n \u0111\u1ED9ng servo v\xF2ng k\xEDn d\xF9ng trong t\u1EF1 \u0111\u1ED9ng
    h\xF3a c\xF4ng nghi\u1EC7p. Ng\u01B0\u1EDDi h\u1ECDc s\u1EBD quan s\xE1t m\xF4
    h\xECnh, \u0111\u1EA5u n\u1ED1i, thi\u1EBFt l\u1EADp tham s\u1ED1, v\u1EADn h\xE0nh
    v\xE0 \u0111\xE1nh gi\xE1 \u0111\u1ED9 ch\xEDnh x\xE1c c\u1EE7a h\u1EC7 th\u1ED1ng.\n\n\u2022
    Hi\u1EC3u vai tr\xF2 ph\u1ED1i h\u1EE3p gi\u1EEFa PLC Mitsubishi FX3U, HMI GOT1000,
    Servo Driver, \u0111\u1ED9ng c\u01A1 BLDC Servo v\xE0 Encoder.\n\u2022 Th\u1EF1c
    h\xE0nh \u0111\u1EA5u n\u1ED1i m\u1EA1ch ngu\u1ED3n, m\u1EA1ch \u0111i\u1EC1u
    khi\u1EC3n xung/h\u01B0\u1EDBng, m\u1EA1ch ph\u1EA3n h\u1ED3i Encoder v\xE0 m\u1EA1ch
    \u0111\u1ED9ng l\u1EF1c.\n\u2022 C\xE0i \u0111\u1EB7t t\u1ED1c \u0111\u1ED9,
    v\u1ECB tr\xED/g\xF3c quay, chi\u1EC1u quay; theo d\xF5i ph\u1EA3n h\u1ED3i tr\xEAn
    HMI \u0111\u1EC3 \u0111\xE1nh gi\xE1 k\u1EBFt qu\u1EA3."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
